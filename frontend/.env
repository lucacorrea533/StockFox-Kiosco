# .env define variables de entorno para el frontend (Vite).
# Vite solo expone al código las variables que empiezan con el prefijo VITE_.
# config.js lee esta variable para saber a qué backend apuntar.

# URL del backend en desarrollo local (Django corriendo en el puerto 8000)
VITE_API_URL=http://127.0.0.1:8000/api

# En Railway, esta misma variable se debe cargar con la URL pública
# del servicio de backend ya desplegado, por ejemplo:
# VITE_API_URL=https://stockfox-backend.up.railway.app/api